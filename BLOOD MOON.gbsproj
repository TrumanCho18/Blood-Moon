                },
                {
                    "command": "EVENT_TEXT",
                    "args": {
                        "text": [
                            "Kris: hey, \nmr.booker...",
                            "you worked with my \ndad, right?",
                            "why do you think we\narent aloud to \nleave town?",
                            "my dad said he \ndidnt know...",
                            "mr.booker: Im not \ntoo sure either...",
                            "I guess I havent \nreally thought\nabout it before.",
                            "Kris:...",
                            "I used to tell my \ndad I would one day \nexplore the rest of \nthe world...",
                            "mr.booker:...",
                            "mr.booker: well...\nI have business to\nattend to..",
                            "Ill see you around,\nKris."
                        ],
                        "avatarId": ""
                    },
                    "id": "58c969c6-1716-437a-bf61-284a09001c01"
                },
