                            "args": {
                                "variable": "17",
                                "__collapseElse": false
                            },
                            "children": {
                                "true": [
                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "pg.1: \"Today, I\nstarted a new\njournal.\"",
                                                "\"my findings were\njust too \ninteresting to keep\nfrom the world\"",
                                                "\"Ive come across \nanother shadowy-sin\ncreature...\"",
                                                "\"but this one is\ndifferent.\nit seems to be \nstronger than the",
                                                "others\"",
                                                "\"Ive tried \neverything I can, \nand I am unable to\nkill off these sins",
                                                "one of them fatally\nwounded me...\nI dont think Ill \nsurvive...\"",
                                                "\"I guess this means\nthat humanity must\nlive on until the \nworld is void of ",
                                                "life. and in \nreturn, the sins\nwill eventually die\noff as well.\"",
                                                "\"this is my last \njournal entry, and\nmy last minutes of\nlife...",
                                                "I have so many \nregrets, yet so\nlittle time...\"",
                                                "\"Kris--\"",
                                                "(it seems that your\nfather died before\nfinishing his \njournal entry)",
                                                "Kris: ...",
                                                "Kris: what now?",
                                                "if theres nothing I\ncan do to stop \nthis... then do I \njust go home?",
                                                "..."
                                            ],
                                            "avatarId": "",
                                            "__collapse": false
                                        },
                                        "id": "5c4e3630-7ae9-4223-8962-8c33a6f37862"
                                    },
