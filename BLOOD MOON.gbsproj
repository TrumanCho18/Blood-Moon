            "script": [
                {
                    "command": "EVENT_MUSIC_STOP",
                    "args": {},
                    "id": "cd0f561a-54de-435b-8670-d7701c8ccb9a"
                },
                {
                    "command": "EVENT_TEXT",
                    "args": {
                        "text": [
                            "\"however, these \nsins are killing \nthe earths life and\nnature.",
                            "and in return, the \nlack of life kills\nthe sins.",
                            "because of this,\nour world is being\nenveloped in sand.\nmaking a desert.",
                            "soon, both the sins\nand our world will\nperish.",
                            "deep in the desert,\nI will make a \nsettlement. and try\nto figure out how",
                            "to get rid of the\nsins.\"",
                            "\"...\"",
                            "\"this whole time, I\nthought humanity\nwas punished by the\nworld...",
                            "but I guess our \nsins are what \ncaused this to \nhappen...",
                            "we were really \nbeing punished by\nourselves...",
                            "we were the real\nmonsters...\"",
                            "\"I may never go \nback home, and I am\nleaving this diary\nbehind.",
                            "I hope some day to\nsee my family \nagain\"",
                            "-end of the diary-",
                            "Kris: ...\n",
                            "so my dad might\nstill be alive...",
                            "I have to go help\nhim. ",
                            "I need to find that\ndesert."
                        ],
                        "avatarId": ""
                    },
                    "id": "71476fa6-74a7-4106-85fd-d06fc98235d3"
                }
            ],
            "playerHit1Script": [],
            "playerHit2Script": [],
            "playerHit3Script": []
        },
